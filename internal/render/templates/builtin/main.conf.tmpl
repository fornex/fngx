{{- /*
Main nginx configuration. Built-in only; it cannot be overridden because the
apply engine depends on its pid file and on the relative include paths.
Directive references:
  https://nginx.org/en/docs/ngx_core_module.html (user, pid, error_log, include)
  https://nginx.org/en/docs/http/ngx_http_core_module.html (listen, server_names_hash_*)
  https://nginx.org/en/docs/http/ngx_http_ssl_module.html (ssl_protocols, ssl_reject_handshake)
  https://nginx.org/en/docs/http/request_processing.html (default server)
*/ -}}
# Generated by {{.Product}}. Do not edit: changes are overwritten.
{{- with .User}}
user {{.}};
{{- end}}
worker_processes auto;
pid {{.PIDFile}};
error_log {{.ErrorLog}};

events {
    worker_connections {{.WorkerConnections}};
}

http {
    include {{.MimeTypes}};
    default_type application/octet-stream;
    sendfile on;
    server_tokens off;
{{- with .AccessLog}}
    access_log {{.}};
{{- else}}
    access_log off;
{{- end}}
{{- with .Temp}}
    client_body_temp_path {{.ClientBody}};
    proxy_temp_path {{.Proxy}};
    fastcgi_temp_path {{.FastCGI}};
    uwsgi_temp_path {{.UWSGI}};
    scgi_temp_path {{.SCGI}};
{{- end}}

    # Up to 10,000 domains with aliases, names up to 253 characters (N-1).
    server_names_hash_max_size 131072;
    server_names_hash_bucket_size 512;

    ssl_protocols{{range .SSLProtocols}} {{.}}{{end}};
    ssl_session_cache shared:SSL:10m;

    # Default servers: requests whose Host matches no domain. HTTPS
    # handshakes without a known name are rejected so that no domain's
    # certificate is shown for a foreign name.
{{- range .Defaults}}
{{- if .TLS}}
    server {
        listen {{.Listen}} ssl default_server;
{{- with .QUIC}}
        listen {{.}} quic reuseport default_server;
{{- end}}
        ssl_reject_handshake on;
    }
{{- else}}
    server {
        listen {{.Listen}} default_server;
{{- with $.Apache}}
        location / {
            proxy_pass {{.}};
            include {{"snippets/proxy.conf" | q}};
        }
{{- else}}
        return 444;
{{- end}}
    }
{{- end}}
{{- end}}

    include vhosts/*.conf;
}

### domains/addon.example/http-include.conf
location = /admin-http { return 200 "admin http\n"; }
deny 198.51.100.7;
### domains/addon.example/http-rewrite.conf
rewrite ^/admin-old$ /admin-new permanent;
### domains/addon.example/https-include.conf
location = /admin-https { return 200 "admin https\n"; }
### domains/addon.example/https-rewrite.conf
rewrite ^/admin-old$ /admin-new-tls permanent;
### vhosts/addon.example.conf
# Generated by fngx for addon.example (hybrid mode). Do not edit.

server {
    listen 192.0.2.10:80;
    server_name addon.example;
    root /home/alice/addon.example;
    disable_symlinks if_not_owner;

    # Hidden files (.htaccess, .user.ini, .git/...) except /.well-known/,
    # which certificate validation needs (M-2). Checked at server level,
    # before any location is chosen, so no location of an admin or client
    # rule (including "^~" prefixes, which skip regex locations) can serve
    # them. $uri is the decoded, normalized URI.
    if ($uri ~ "/\.(?!well-known(?:/|$))") {
        return 403;
    }
    include domains/addon.example/http-rewrite.conf;
    include domains/addon.example/http-include.conf;

    location / {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }

    location ~* "\.(?:7z|avif|bmp|css|csv|doc|docx|eot|flv|gif|gz|ico|jpeg|jpg|js|json|map|mp3|mp4|ogg|otf|pdf|png|ppt|pptx|rar|svg|svgz|tar|tgz|tif|tiff|ttf|txt|wav|webm|webp|woff|woff2|xls|xlsx|xml|zip)$" {
        try_files $uri @backend;
    }

    location @backend {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }
}

server {
    listen 192.0.2.10:443 ssl;
    server_name addon.example;
    ssl_certificate /etc/ssl/test/addon.example.crt;
    ssl_certificate_key /etc/ssl/test/addon.example.key;
    http2 on;
    root /home/alice/addon.example;
    disable_symlinks if_not_owner;

    # Hidden files (.htaccess, .user.ini, .git/...) except /.well-known/,
    # which certificate validation needs (M-2). Checked at server level,
    # before any location is chosen, so no location of an admin or client
    # rule (including "^~" prefixes, which skip regex locations) can serve
    # them. $uri is the decoded, normalized URI.
    if ($uri ~ "/\.(?!well-known(?:/|$))") {
        return 403;
    }
    include domains/addon.example/https-rewrite.conf;
    include domains/addon.example/https-include.conf;

    location / {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }

    location ~* "\.(?:7z|avif|bmp|css|csv|doc|docx|eot|flv|gif|gz|ico|jpeg|jpg|js|json|map|mp3|mp4|ogg|otf|pdf|png|ppt|pptx|rar|svg|svgz|tar|tgz|tif|tiff|ttf|txt|wav|webm|webp|woff|woff2|xls|xlsx|xml|zip)$" {
        try_files $uri @backend;
    }

    location @backend {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }
}

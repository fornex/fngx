### domains/example.net/client.conf
location = /teapot {
    return 418;
}
add_header X-Client "yes it is";
rewrite ^/old/(.*)$ /new/$1 permanent;
location ~* \.png$ {
    expires 30d;
}
deny 203.0.113.0/24;
### domains/example.net/http-include.conf
location = /admin-http { return 200 "admin http\n"; }
deny 198.51.100.7;
### domains/example.net/http-rewrite.conf
rewrite ^/admin-old$ /admin-new permanent;
### domains/example.net/https-include.conf
location = /admin-https { return 200 "admin https\n"; }
### domains/example.net/https-rewrite.conf
rewrite ^/admin-old$ /admin-new-tls permanent;
### vhosts/example.net.conf
# Generated by fngx for example.net (nginx mode). Do not edit.

server {
    listen 80;
    server_name example.net www.example.net;
    root /home/alice/example.net;
    index index.php index.html index.htm;
    disable_symlinks if_not_owner from=$document_root;

    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
    }
    include domains/example.net/http-rewrite.conf;
    include domains/example.net/http-include.conf;
    include domains/example.net/client.conf;

    # Application template (T-2).
    include apps/generic-php.conf;

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/run/php-fpm/example.net.sock;
        include snippets/fastcgi.conf;
    }
}

server {
    listen 443 ssl;
    listen 443 quic;
    server_name example.net www.example.net;
    ssl_certificate /etc/ssl/test/example.net.crt;
    ssl_certificate_key /etc/ssl/test/example.net.key;
    http2 on;
    add_header Alt-Svc 'h3=":443"; ma=86400';
    root /home/alice/example.net;
    index index.php index.html index.htm;
    disable_symlinks if_not_owner from=$document_root;

    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
    }
    include domains/example.net/https-rewrite.conf;
    include domains/example.net/https-include.conf;
    include domains/example.net/client.conf;

    # Application template (T-2).
    include apps/generic-php.conf;

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass unix:/run/php-fpm/example.net.sock;
        include snippets/fastcgi.conf;
    }
}

{{- /*
proxy mode (T-1): every request goes to Apache (section 5, M-6). nginx serves
no files itself unless an admin or client rule adds a location that does;
root and disable_symlinks keep such a location to the owner's own files
(Q-6): a symbolic link whose owner differs from its target's is not
followed, in any component of the path, including the document root itself.
Hidden files are not denied here, so that behaviour stays that of Apache.
*/ -}}
# Generated by {{.Product}} for {{.Domain}} ({{.Mode}} mode). Do not edit.
{{- range .Servers}}

server {
{{- template "listen" .}}
    server_name{{range $.Names}} {{.}}{{end}};
{{- template "tls" .}}
    root {{$.Root}};
    disable_symlinks if_not_owner;
{{- template "includes" .}}

    location / {
{{- template "proxy" .}}
    }
}
{{- end}}

### nginx.conf
# Generated by fngx. Do not edit: changes are overwritten.
worker_processes auto;
pid /run/fngx/nginx.pid;
error_log /var/log/fngx/nginx/error.log;

events {
    worker_connections 4096;
}

http {
    include /etc/fngx/nginx/mime.types;
    default_type application/octet-stream;
    sendfile on;
    server_tokens off;
    access_log off;
    client_body_temp_path /var/tmp/nginx/client_body;
    proxy_temp_path /var/tmp/nginx/proxy;
    fastcgi_temp_path /var/tmp/nginx/fastcgi;
    uwsgi_temp_path /var/tmp/nginx/uwsgi;
    scgi_temp_path /var/tmp/nginx/scgi;

    # Up to 10,000 domains with aliases, names up to 253 characters (N-1).
    server_names_hash_max_size 131072;
    server_names_hash_bucket_size 512;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # Default servers: requests whose Host matches no domain. HTTPS
    # handshakes without a known name are rejected so that no domain's
    # certificate is shown for a foreign name.
    server {
        listen 203.0.113.5:80 default_server;
        return 444;
    }
    server {
        listen [2001:db8::5]:80 default_server;
        return 444;
    }
    server {
        listen 203.0.113.5:443 ssl default_server;
        ssl_reject_handshake on;
    }
    server {
        listen [2001:db8::5]:443 ssl default_server;
        ssl_reject_handshake on;
    }

    include vhosts/*.conf;
}
### snippets/fastcgi.conf
# Generated. FastCGI parameters for PHP-FPM in nginx mode (M-9).
#
# Written from the CGI/1.1 meta-variables of RFC 3875 section 4.1 and the
# fastcgi_param directive
# (https://nginx.org/en/docs/http/ngx_http_fastcgi_module.html#fastcgi_param).
# fastcgi_param is inherited only when the current level defines none, so
# this file is included inside the PHP location.
fastcgi_param GATEWAY_INTERFACE CGI/1.1;
fastcgi_param SERVER_SOFTWARE nginx;
fastcgi_param SERVER_PROTOCOL $server_protocol;
fastcgi_param SERVER_NAME $server_name;
fastcgi_param SERVER_ADDR $server_addr;
fastcgi_param SERVER_PORT $server_port;
fastcgi_param REMOTE_ADDR $remote_addr;
fastcgi_param REMOTE_PORT $remote_port;
fastcgi_param REQUEST_METHOD $request_method;
fastcgi_param REQUEST_SCHEME $scheme;
fastcgi_param REQUEST_URI $request_uri;
fastcgi_param DOCUMENT_URI $document_uri;
fastcgi_param DOCUMENT_ROOT $document_root;
fastcgi_param SCRIPT_NAME $fastcgi_script_name;
fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
fastcgi_param QUERY_STRING $query_string;
fastcgi_param CONTENT_TYPE $content_type;
fastcgi_param CONTENT_LENGTH $content_length;
fastcgi_param HTTPS $https if_not_empty;
# Do not pass a client "Proxy" header on as HTTP_PROXY ("httpoxy").
fastcgi_param HTTP_PROXY "";
### snippets/proxy.conf
# Generated. Request headers for Apache in proxy and hybrid mode (M-6).
#
# proxy_set_header is inherited only when the current level defines none
# (https://nginx.org/en/docs/http/ngx_http_proxy_module.html#proxy_set_header),
# so this file is included inside every location that proxies, and a
# location that adds its own header must include it as well.
#
# Host: the default is $proxy_host, the backend address; Apache needs the
# requested name to pick the virtual host.
proxy_set_header Host $host;
# The visitor address for Apache and its logs. $proxy_add_x_forwarded_for
# appends $remote_addr to the X-Forwarded-For sent by the client, so only its
# last element was added by nginx; Apache must trust only that one (for
# example mod_remoteip with nginx as the internal proxy).
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
# Do not pass a client "Proxy" header on to CGI programs as HTTP_PROXY
# (the "httpoxy" issue): an empty value removes the header.
proxy_set_header Proxy "";

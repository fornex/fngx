### domains/shop.example.org/client.conf
location = /teapot {
    return 418;
}
add_header X-Client "yes it is";
rewrite ^/old/(.*)$ /new/$1 permanent;
location ~* \.png$ {
    expires 30d;
}
deny 203.0.113.0/24;
location ^~ /app/ {
    expires 1h;
}
### domains/shop.example.org/http-include.conf
location = /admin-http { return 200 "admin http\n"; }
deny 198.51.100.7;
### domains/shop.example.org/http-rewrite.conf
rewrite ^/admin-old$ /admin-new permanent;
### domains/shop.example.org/https-include.conf
location = /admin-https { return 200 "admin https\n"; }
### domains/shop.example.org/https-rewrite.conf
rewrite ^/admin-old$ /admin-new-tls permanent;
### vhosts/shop.example.org.conf
# Generated by fngx for shop.example.org (proxy mode). Do not edit.

server {
    listen 192.0.2.10:80;
    listen [2001:db8::10]:80;
    server_name shop.example.org;
    root /home/alice/shop.example.org;
    disable_symlinks if_not_owner;
    include domains/shop.example.org/http-rewrite.conf;
    include domains/shop.example.org/http-include.conf;
    include domains/shop.example.org/client.conf;

    location / {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }
}

server {
    listen 192.0.2.10:443 ssl;
    listen [2001:db8::10]:443 ssl;
    listen 192.0.2.10:443 quic;
    listen [2001:db8::10]:443 quic;
    server_name shop.example.org;
    ssl_certificate /etc/ssl/test/shop.example.org.crt;
    ssl_certificate_key /etc/ssl/test/shop.example.org.key;
    http2 on;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    root /home/alice/shop.example.org;
    disable_symlinks if_not_owner;
    include domains/shop.example.org/https-rewrite.conf;
    include domains/shop.example.org/https-include.conf;
    include domains/shop.example.org/client.conf;

    location / {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }
}

{{- /*
proxy mode (T-1): every request goes to Apache (section 5, M-6). nginx serves
no files itself unless an admin or client rule adds a location that does;
root and disable_symlinks make such a location safe on a shared server
(Q-6): a symbolic link to a file owned by another user is not followed.
*/ -}}
# Generated by {{.Product}} for {{.Domain}} ({{.Mode}} mode). Do not edit.
{{- range .Servers}}

server {
{{- template "listen" .}}
    server_name{{range $.Names}} {{.}}{{end}};
{{- template "tls" .}}
    root {{$.Root}};
    disable_symlinks if_not_owner from=$document_root;
{{- template "includes" .}}

    location / {
{{- template "proxy" .}}
    }
}
{{- end}}

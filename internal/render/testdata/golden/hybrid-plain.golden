### vhosts/example.com.conf
# Generated by fngx for example.com (hybrid mode). Do not edit.

server {
    listen 80;
    server_name example.com;
    root /home/alice/example.com;
    disable_symlinks if_not_owner;

    # Hidden files (.htaccess, .user.ini, .git/...) except /.well-known/,
    # which certificate validation needs (M-2). Checked at server level,
    # before any location is chosen, so no location of an admin or client
    # rule (including "^~" prefixes, which skip regex locations) can serve
    # them. $uri is the decoded, normalized URI.
    if ($uri ~ "/\.(?!well-known(?:/|$))") {
        return 403;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }

    location ~* "\.(?:7z|avif|bmp|css|csv|doc|docx|eot|flv|gif|gz|ico|jpeg|jpg|js|json|map|mp3|mp4|ogg|otf|pdf|png|ppt|pptx|rar|svg|svgz|tar|tgz|tif|tiff|ttf|txt|wav|webm|webp|woff|woff2|xls|xlsx|xml|zip)$" {
        try_files $uri @backend;
    }

    location @backend {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }
}

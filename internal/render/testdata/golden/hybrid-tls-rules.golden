### domains/example.net/client.conf
location = /teapot {
    return 418;
}
add_header X-Client "yes it is";
rewrite ^/old/(.*)$ /new/$1 permanent;
location ~* \.png$ {
    expires 30d;
}
deny 203.0.113.0/24;
### vhosts/example.net.conf
# Generated by fngx for example.net (hybrid mode). Do not edit.

server {
    listen 80;
    server_name example.net www.example.net;
    root /home/alice/example.net;
    disable_symlinks if_not_owner from=$document_root;
    include domains/example.net/client.conf;

    location / {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }

    location ~* "\.(?:css|js|png)$" {
        try_files $uri @backend;
    }

    location @backend {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }
}

server {
    listen 443 ssl;
    listen 443 quic;
    server_name example.net www.example.net;
    ssl_certificate /etc/ssl/test/example.net.crt;
    ssl_certificate_key /etc/ssl/test/example.net.key;
    http2 on;
    add_header Alt-Svc 'h3=":443"; ma=86400';
    root /home/alice/example.net;
    disable_symlinks if_not_owner from=$document_root;
    include domains/example.net/client.conf;

    location / {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }

    location ~* "\.(?:css|js|png)$" {
        try_files $uri @backend;
    }

    location @backend {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }
}

### vhosts/example.net.conf
# Generated by fngx for example.net (proxy mode). Do not edit.

server {
    listen 80;
    server_name example.net parked.example www.example.net;
    root /home/alice/example.net;
    disable_symlinks if_not_owner;

    location / {
        proxy_pass http://127.0.0.1:8080;
        include snippets/proxy.conf;
    }
}

server {
    listen 443 ssl;
    listen 443 quic;
    server_name example.net parked.example www.example.net;
    ssl_certificate /etc/ssl/test/example.net.crt;
    ssl_certificate_key /etc/ssl/test/example.net.key;
    http2 on;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
    root /home/alice/example.net;
    disable_symlinks if_not_owner;

    location / {
        proxy_pass https://127.0.0.1:8443;
        include snippets/proxy.conf;
        proxy_ssl_server_name on;
        proxy_ssl_name $host;
    }
}

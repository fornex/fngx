{{- /*
nginx (standalone) mode (T-1): nginx serves files and passes PHP to the
domain's PHP-FPM pool (M-9); Apache is not involved and .htaccess does not
apply (M-8).

Location order matters only among regex locations, which are checked in
order of appearance (ngx_http_core_module.html#location):
  - hidden files are denied before any include, so no rule can expose
    .htaccess, .user.ini or .git; /.well-known/ stays reachable for
    certificate validation (M-2);
  - the PHP location comes after the includes, so a client may refine it for
    own paths (shadowing it affects only the client's own site).
try_files $uri =404 in the PHP location stops a request for a script that
does not exist from reaching PHP-FPM.
*/ -}}
# Generated by {{.Product}} for {{.Domain}} ({{.Mode}} mode). Do not edit.
{{- range .Servers}}

server {
{{- template "listen" .}}
    server_name{{range $.Names}} {{.}}{{end}};
{{- template "tls" .}}
    root {{$.Root}};
    index index.php index.html index.htm;
    disable_symlinks if_not_owner from=$document_root;

    location ~ /\.(?!well-known(?:/|$)) {
        deny all;
    }
{{- template "includes" .}}
{{- with $.App}}

    # Application template (T-2).
    include {{.}};
{{- else}}

    location / {
        try_files $uri $uri/ =404;
    }
{{- end}}

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass {{$.PHP.Pass}};
        include snippets/fastcgi.conf;
    }
}
{{- end}}

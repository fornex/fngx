{{- /*
hybrid mode (T-1): nginx serves files with the configured extensions itself
(M-7); everything else, and a static file that does not exist, goes to Apache
(M-6). .htaccess rules do not apply to the files nginx serves (M-8).
try_files with a named location as the last parameter falls back to it.
*/ -}}
# Generated by {{.Product}} for {{.Domain}} ({{.Mode}} mode). Do not edit.
{{- range .Servers}}

server {
{{- template "listen" .}}
    server_name{{range $.Names}} {{.}}{{end}};
{{- template "tls" .}}
    root {{$.Root}};
    disable_symlinks if_not_owner from=$document_root;
{{- template "includes" .}}

    location / {
{{- template "proxy" .}}
    }
{{- with $.Static}}

    location ~* {{.Regex}} {
        try_files $uri @backend;
    }
{{- end}}

    location @backend {
{{- template "proxy" .}}
    }
}
{{- end}}

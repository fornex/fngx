{{- /*
hybrid mode (T-1): nginx serves files with the configured extensions itself
(M-7); everything else, and a static file that does not exist, goes to Apache
(M-6). .htaccess rules do not apply to the files nginx serves (M-8).
try_files with a named location as the last parameter falls back to it.
*/ -}}
# Generated by {{.Product}} for {{.Domain}} ({{.Mode}} mode). Do not edit.
{{- range .Servers}}

server {
{{- template "listen" .}}
    server_name{{range $.Names}} {{.}}{{end}};
{{- template "tls" .}}
    root {{$.Root}};
    disable_symlinks if_not_owner;

    # Hidden files (.htaccess, .user.ini, .git/...) except /.well-known/,
    # which certificate validation needs (M-2). Checked at server level,
    # before any location is chosen, so no location of an admin or client
    # rule (including "^~" prefixes, which skip regex locations) can serve
    # them. $uri is the decoded, normalized URI.
    if ($uri ~ "/\.(?!well-known(?:/|$))") {
        return 403;
    }
{{- template "includes" .}}

    location / {
{{- template "proxy" .}}
    }
{{- with $.Static}}

    location ~* {{.Regex}} {
        try_files $uri @backend;
    }
{{- end}}

    location @backend {
{{- template "proxy" .}}
    }
}
{{- end}}

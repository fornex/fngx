# Pinned versions of every component that build.sh downloads.
# Sourced by build.sh; plain KEY=value lines only.
#
# Every tarball is checked twice: its SHA-256 must match the value below
# and its detached PGP signature must be made by one of the listed primary
# key fingerprints (public keys are in keys/). When NGINX_VERSION is
# overridden on the command line, no SHA-256 is pinned for it and the PGP
# signature alone is checked.
#
# Update procedure: docs/build.md, section "Updating pinned versions".

# nginx stable branch. https://nginx.org/en/download.html
NGINX_VERSION=1.30.8
NGINX_SHA256=f867314ada32e717b949930859656c48a72dc6657aec598db58af2f98a40e1c1
NGINX_URL_BASE=https://nginx.org/download
# Release signing keys listed on https://nginx.org/en/pgp_keys.html
NGINX_PGP_FPRS="43387825DDB1BB97EC36BA5D007C8D7C15D87369 D6786CE303D9A9022998DC6CC8464D549AF75C0A 7338973069ED3F443F4D37DFA64FD5B17ADB39A8 13C82A63B603576156E30A4EA0EA981B66B0D967 AC50DD4E7CD5D51FD00D1F4C4DB15B66AA75322B"

# OpenSSL 3.5 LTS, linked statically into nginx for native QUIC support.
# https://openssl-library.org/source/
OPENSSL_VERSION=3.5.9
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a
OPENSSL_URL_BASE=https://github.com/openssl/openssl/releases/download
OPENSSL_PGP_FPRS="B146647E45A7B33947AB226B2A2C87D161692D40"

# libmodsecurity (ModSecurity v3). https://github.com/owasp-modsecurity/ModSecurity
MODSECURITY_VERSION=3.0.17
MODSECURITY_SHA256=f283b33d5c21130fd3a15c84a93a1abe12bd1949edaf44288b12af571b671a50
MODSECURITY_URL_BASE=https://github.com/owasp-modsecurity/ModSecurity/releases/download
MODSECURITY_PGP_FPRS="0B2BA1924065B44691202A2AD286E022149F0F6E"

# nginx connector for libmodsecurity. https://github.com/owasp-modsecurity/ModSecurity-nginx
MODSECURITY_NGINX_VERSION=1.0.4
MODSECURITY_NGINX_SHA256=6bdc7570911be884c1e43aaf85046137f9fde0cfa0dd4a55b853c81c45a13313
MODSECURITY_NGINX_URL_BASE=https://github.com/owasp-modsecurity/ModSecurity-nginx/releases/download
MODSECURITY_NGINX_PGP_FPRS="0B2BA1924065B44691202A2AD286E022149F0F6E"
